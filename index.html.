    </main>

    <!-- Motor JavaScript en Tiempo Real -->
    <script>
        const STABLECOINS = ['USDC', 'FDUSD', 'USDT', 'TUSD', 'DAI', 'BUSD', 'EUR', 'GBP', 'WBTC', 'AEUR'];

        function getBinanceUrl(ticker) {
            const clean = ticker.replace('USDT', '');
            return `https://www.binance.com/es-AR/trade/${clean}_USDT`;
        }

        async function forzarSincronizacion() {
            const btn = document.getElementById('btn-sincronizar');
            const icon = document.getElementById('icon-sync');
            icon.classList.add('animate-spin');
            await cargarDatosBinanceEnVivo();
            setTimeout(() => icon.classList.remove('animate-spin'), 600);
        }

        async function cargarDatosBinanceEnVivo() {
            try {
                const res = await fetch('https://api.binance.com/api/v3/ticker/24hr');
                if (!res.ok) throw new Error("Error conectando a Binance");
                
                const tickers = await res.json();
                const paresValidos = tickers.filter(t => {
                    const symbol = t.symbol;
                    if (!symbol.endsWith('USDT')) return false;
                    const clean = symbol.replace('USDT', '');
                    if (STABLECOINS.includes(clean)) return false;
                    if (symbol.includes('UP') || symbol.includes('DOWN') || symbol.includes('BEAR') || symbol.includes('BULL')) return false;
                    return parseFloat(t.quoteVolume) > 100000;
                });

                // MÓDULO 1: Top Ganadoras
                const ganadoras = [...paresValidos]
                    .sort((a, b) => parseFloat(b.priceChangePercent) - parseFloat(a.priceChangePercent))
                    .slice(0, 6)
                    .map(t => ({ ticker: t.symbol.replace('USDT', ''), val: '+' + parseFloat(t.priceChangePercent).toFixed(2) + '%' }));

                // MÓDULO 2: Top Perdedoras
                const perdedoras = [...paresValidos]
                    .sort((a, b) => parseFloat(a.priceChangePercent) - parseFloat(b.priceChangePercent))
                    .slice(0, 6)
                    .map(t => ({ ticker: t.symbol.replace('USDT', ''), val: parseFloat(t.priceChangePercent).toFixed(2) + '%' }));

                // MÓDULO 3: Acumulación 24h
                const acumulacion = [...paresValidos]
                    .sort((a, b) => parseFloat(b.quoteVolume) - parseFloat(a.quoteVolume))
                    .slice(0, 6)
                    .map(t => ({ ticker: t.symbol.replace('USDT', ''), val: `$${(parseFloat(t.quoteVolume)/1000000).toFixed(1)}M` }));

                // MÓDULO 4: Silenciosa
                const silenciosa = [...paresValidos]
                    .filter(t => parseFloat(t.priceChangePercent) > 0 && parseFloat(t.priceChangePercent) < 3.0)
                    .sort((a, b) => parseFloat(b.quoteVolume) - parseFloat(a.quoteVolume))
                    .slice(0, 6)
                    .map(t => ({ ticker: t.symbol.replace('USDT', ''), val: `+${parseFloat(t.priceChangePercent).toFixed(1)}%` }));

                // MÓDULO 5: Táctico
                const tactico = [...paresValidos]
                    .filter(t => parseFloat(t.lastPrice) < 5.0 && parseFloat(t.quoteVolume) > 2000000)
                    .sort((a, b) => parseFloat(b.priceChangePercent) - parseFloat(a.priceChangePercent))
                    .slice(0, 4)
                    .map(t => ({ ticker: t.symbol.replace('USDT', ''), val: `$${parseFloat(t.lastPrice).toFixed(3)} (+${parseFloat(t.priceChangePercent).toFixed(1)}%)` }));

                // MÓDULO 6: Convertidas
                const convertidas = ganadoras.slice(0, 4).map(g => ({
                    ticker: g.ticker,
                    val: `VENCEDORA (${g.val})`
                }));

                // MÓDULO 7: Semanal simulado
                const semanal = [
                    { ticker: 'SOL', barra: '████████████', total: 16, tendencia: '🟢 Alcista' },
                    { ticker: 'LINK', barra: '███', total: 3, tendencia: '🟢 Estable' },
                    { ticker: 'NEAR', barra: '███', total: 3, tendencia: '🟢 Estable' },
                    { ticker: 'RNDR', barra: '███', total: 3, tendencia: '🟡 Neutro' }
                ];

                renderizarUI(ganadoras, perdedoras, acumulacion, silenciosa, tactico, convertidas, semanal);
            } catch (e) {
                console.error("Error sincronizando Binance:", e);
            }
        }

        function renderizarUI(g, p, ac, sil, tac, conv, sem) {
            renderizarLista('container-modulo1', g, 'text-accentGreen');
            renderizarLista('container-modulo2', p, 'text-accentRed');
            renderizarLista('container-modulo3', ac, 'text-accentBlue');
            renderizarLista('container-modulo4', sil, 'text-accentPurple');
            renderizarLista('container-modulo5', tac, 'text-accentGold');
            renderizarLista('container-modulo6', conv, 'text-accentGreen');

            const tbody7 = document.getElementById('tabla-modulo7');
            tbody7.innerHTML = sem.map(s => `
                <tr class="hover:bg-slate-900 transition">
                    <td class="p-2 font-bold text-slate-100">${s.ticker}</td>
                    <td class="p-2 text-accentGreen font-mono text-[11px]">${s.barra}</td>
                    <td class="p-2 text-center font-bold text-slate-300">${s.total}</td>
                    <td class="p-2 text-right font-medium text-emerald-400">${s.tendencia}</td>
                </tr>
            `).join('');
        }

        function renderizarLista(id, items, color) {
            const el = document.getElementById(id);
            if (!items || !items.length) { el.innerHTML = `<span class="text-slate-500 text-xs">Sin datos</span>`; return; }
            el.innerHTML = items.map(i => `
                <a href="${getBinanceUrl(i.ticker)}" target="_blank" class="flex justify-between items-center py-1.5 px-2.5 rounded bg-slate-900 border border-slate-800 hover:border-slate-600 transition group">
                    <span class="font-bold text-xs text-slate-100 group-hover:text-accentGold">${i.ticker}</span>
                    <span class="font-bold text-xs ${color}">${i.val}</span>
                </a>
            `).join('');
        }

        window.onload = cargarDatosBinanceEnVivo;
    </script>
