name: Bot Resumen Diario Telegram

on:
  schedule:
    - cron: '0 3 * * *' # 03:00 UTC = 00:00 hs en Argentina (UTC-3)
  workflow_dispatch:

jobs:
  run-diario:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout del repositorio
        uses: actions/checkout@v3

      - name: Configurar Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.10'

      - name: Instalar dependencias
        run: |
          python -m pip install --upgrade pip
          pip install requests

      - name: Ejecutar Bot Diario
        env:
          TELEGRAM_BOT_TOKEN: ${{ secrets.TELEGRAM_BOT_TOKEN }}
          TELEGRAM_CHAT_ID: ${{ secrets.TELEGRAM_CHAT_ID }}
          TOPIC_ID_GANADORAS: ${{ secrets.TOPIC_ID_GANADORAS }}
        run: |
          python bot_diario.py

      - name: Guardar y commitear archivos de resumen en el repo
        run: |
          git config --local user.email "action@github.com"
          git config --local user.name "GitHub Action"
          git add resumen_final_*.json datos_ganadoras_*.json
          git commit -m "Guardar consolidado diario de ganadoras" || exit 0
          git push
